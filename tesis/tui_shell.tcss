/* New run-console shell only. Legacy dashboard/menu styling stays in TesisApp.CSS. */

RunConsoleScreen {
    layout: vertical;
    /* Theme-safe: overrides the hardcoded dark Screen background from
       TesisApp.CSS so header/transcript/composer share one coherent
       surface in dark, light, and ANSI themes. */
    background: $background;
    color: $foreground;
}

#console-header,
#console-coords,
#console-transcript,
#console-empty,
#console-status,
#console-hints {
    background: $background;
}

RunConsoleScreen.wide #console-coords {
    height: auto;
    max-height: 10;
    padding: 0 1;
    color: $text-muted;
}

RunConsoleScreen.standard #console-coords,
RunConsoleScreen.narrow #console-coords {
    display: none;
}

#console-header {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

#console-transcript {
    height: 1fr;
    padding: 0 1;
}

#console-empty {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

#console-composer {
    height: 3;
    border: round $primary;
    margin: 0 1;
}

#console-composer:focus {
    border: round $accent;
}

#console-status {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

#console-hints {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

RunConsoleScreen.narrow #console-hints {
    display: none;
}

RunConsoleScreen.narrow #console-composer {
    margin: 0;
}

RunConsoleScreen.standard #console-composer {
    margin: 0 1;
}

.shell-overlay {
    width: 72;
    max-width: 92%;
    height: auto;
    max-height: 92%;
    padding: 1 2;
    border: round $primary;
    background: $surface;
}

RunConsoleScreen.narrow .shell-overlay,
.shell-overlay {
    scrollbar-size: 1 1;
}

.shell-overlay-title {
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

.shell-overlay-body {
    height: auto;
}

.shell-overlay-hint {
    height: 1;
    margin-top: 1;
    color: $text-muted;
}
